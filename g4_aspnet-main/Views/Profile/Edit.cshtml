@model ProfileEditViewModel
@inject ImageStorage ImageStorage
@{
    ViewData["Title"] = "Editar perfil";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h2 mb-0">Editar perfil</h1>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
        <form method="post" enctype="multipart/form-data" class="card">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="DisplayName" class="form-label"></label>
                    <input asp-for="DisplayName" class="form-control" />
                    <span asp-validation-for="DisplayName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                @if (ImageStorage.GetUrl(Model.CurrentAvatarFileName) is string avatarUrl)
                {
                    <div class="mb-3 d-flex align-items-center gap-2">
                        <img class="avatar" src="@avatarUrl" alt="Avatar actual" />
                        <div class="form-check">
                            <input asp-for="RemoveAvatar" class="form-check-input" />
                            <label asp-for="RemoveAvatar" class="form-check-label"></label>
                        </div>
                    </div>
                }
                <div class="mb-3">
                    <label asp-for="Avatar" class="form-label"></label>
                    <input asp-for="Avatar" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
                    <span asp-validation-for="Avatar" class="text-danger"></span>
                    <div class="form-text">JPG, PNG, GIF o WEBP; máximo 5 MB.</div>
                </div>
            </div>
            <div class="card-footer bg-transparent text-end">
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
