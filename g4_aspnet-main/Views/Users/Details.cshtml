@model ProfileViewModel
@inject ImageStorage ImageStorage
@{
    ViewData["Title"] = "Detalle de usuario";
    var name = Model.User.DisplayName ?? Model.User.UserName ?? "Usuario";
    var initial = string.IsNullOrWhiteSpace(name) ? "U" : name[..1].ToUpperInvariant();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Detalle de usuario</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.User.Id">Eliminar</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.User.Id">Editar</a>
    </div>
</div>

<div class="card">
    <div class="card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            @if (ImageStorage.GetUrl(Model.User.AvatarFileName) is string avatarUrl)
            {
                <img class="avatar" src="@avatarUrl" alt="Avatar de @name" />
            }
            else
            {
                <span class="avatar avatar-placeholder">@initial</span>
            }
            <div><h2 class="h4 mb-0">@name</h2><span class="text-secondary">@Model.User.UserName</span></div>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.User.Email</dd>
            <dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@(Model.User.IsActive ? "Activa" : "Inactiva")</dd>
            <dt class="col-sm-3">Creada</dt><dd class="col-sm-9">@Model.User.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent"><a class="btn btn-outline-secondary" asp-action="Index">Volver a usuarios</a></div>
</div>
