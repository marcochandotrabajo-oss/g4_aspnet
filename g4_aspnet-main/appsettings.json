{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/g4.db"
  },
  "SeedData": {
    "Enabled": true
  },
  "FileUploads": {
    "Images": {
      "MaxFileSizeBytes": 5242880,
      "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
